# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agent-skills plugin (separate repo, not part of this project)
agent-skills/
Profile.csv

# LinkedIn data exports (contain personal data)
Basic_LinkedInDataExport_*/

# Personal summary doc (contains PII, not for commit)
ABOUT_ILHAM.md

# Generated PDF output
*.pdf

# One-off tailored resume docs + headshot (contain PII, not for commit)
*Resume.html
ilham-headshot.*

# Persistent API usage log (local cost tracking, not for commit)
usage-log.jsonl

# Job application tracker data (local persistence, not for commit)
applications.json

# Generated example resume/cover-letter output (goes stale immediately, duplicates
# PII already in lib/my-profile.ts)
/examples/

# Real profile data (name, contact info, work history) — not for commit.
# Copy lib/my-profile.example.ts to lib/my-profile.ts and fill in your own data.
lib/my-profile.ts
